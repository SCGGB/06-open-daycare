{
  
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
  "external_directory": {
    "/tmp/**": "allow"
  },
  "bash": "allow"
},
    "references": {
      "docs": {
        "path": "../07-DB-Schema",
        "description": "Database schema and documentation"
      }
    
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "agent": {
    "spec-verifier": {
      "model": "opencode/mimo-v2.5-free",
      "mode": "subagent",
      "description": "Verifies acceptance criteria from spec files using Context7, Playwright, and vision"
    }
  }
}
